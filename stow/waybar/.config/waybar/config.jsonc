[
  {
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 2,
    "margin-top": 15,
    "margin-left": 15,
    "margin-right": 15,
    "reload_style_on_change": true,
    "modules-left": [
      "custom/powermenu",
      "custom/app_launcher",
      "hyprland/workspaces",
      "custom/updates"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "custom/mpris",
      "group/systeminfo",
      "custom/recorder",
      "tray",
      "custom/language",
      "pulseaudio",
      "custom/network",
      "power-profiles-daemon",
      "custom/calendar",
      "clock#time",
      "custom/battery",
      "group/settings"
    ],
    "custom/language": {
      "exec": "\"$HOME/.config/waybar/scripts/keyboard-layout.sh\"",
      "return-type": "json",
      "signal": 10,
      "exec-on-event": false,
      "min-length": 2,
      "max-length": 2
    },
    "hyprland/workspaces": {
      "all-outputs": true,
      "show-special": true
    },
    "hyprland/window": {
      "format": "{}",
      "icon": true,
      "icon-size": 14,
      "max-length": 60,
      "separate-outputs": true
    },
    "custom/app_launcher": {
      "format": "󰣇",
      "tooltip": false,
      "on-click": "\"$HOME/.config/hypr/scripts/rofi-current-workspace\" drun"
    },
    "custom/powermenu": {
      "format": "",
      "tooltip": false,
      "on-click": "\"$HOME/.config/waybar/scripts/rofi-single-click-wrapper.sh\" \"$HOME/.config/waybar/scripts/powermenu.sh\""
    },
    "custom/updates": {
      "exec": "bash -lc 'checkupdates 2>/dev/null | wc -l'",
      "interval": 900,
      "signal": 8,
      "exec-on-event": false,
      "format": "󰏖 {}",
      "return-type": "text",
      "tooltip": true,
      "on-click": "kitty \"$HOME/.config/waybar/scripts/pacman-update.sh\""
    },
    "group/systeminfo": {
      "orientation": "inherit",
      "modules": [
        "cpu",
        "memory",
        "temperature"
      ]
    },
    "cpu": {
      "format": " {usage}%",
      "interval": 5
    },
    "memory": {
      "format": "󰍛 {}%"
    },
    "temperature": {
      "critical-threshold": 85,
      "format": " {temperatureC}°C"
    },
    "custom/mpris": {
      "exec": "\"$HOME/.config/waybar/scripts/mpris-status.sh\"",
      "interval": 2,
      "return-type": "json",
      "hide-empty-text": true,
      "exec-on-event": false,
      "on-click": "\"$HOME/.config/waybar/scripts/rofi-single-click-wrapper.sh\" \"$HOME/.config/waybar/scripts/rofi-controls.sh\" player-menu"
    },
    "pulseaudio": {
      "states": {
        "normal": 99,
        "full": 100
      },
      "format": "{icon} {volume}%",
      "format-bluetooth": " {icon} {volume}%",
      "format-muted": "󰝟 muted",
      "format-source": " {volume}%",
      "format-source-muted": " muted",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "on-click": "pavucontrol -t 3",
      "on-click-middle": "\"$HOME/.config/waybar/scripts/ashell-actions.sh\" audio-mute",
      "on-click-right": "pavucontrol -t 4",
      "scroll-step": 2
    },
    "custom/network": {
      "exec": "\"$HOME/.config/waybar/scripts/network-status.sh\"",
      "signal": 9,
      "exec-on-event": false,
      "on-click": "\"$HOME/.config/waybar/scripts/rofi-single-click-wrapper.sh\" \"$HOME/.config/waybar/scripts/rofi-controls.sh\" network-menu",
      "on-click-middle": "pkill -RTMIN+9 waybar",
      "on-click-right": "\"$HOME/.config/waybar/scripts/ashell-actions.sh\" network"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "custom/battery": {
      "exec": "\"$HOME/.config/waybar/scripts/battery-status.sh\"",
      "interval": 30,
      "exec-on-event": false
    },
    "custom/recorder": {
      "exec": "\"$HOME/.config/waybar/scripts/recorder-status.sh\"",
      "interval": 2,
      "return-type": "json",
      "hide-empty-text": true,
      "exec-on-event": false
    },
    "tray": {
      "icon-size": 16,
      "spacing": 10
    },
    "custom/calendar": {
      "exec": "python3 \"$HOME/.config/waybar/scripts/calendar-status.py\"",
      "return-type": "json",
      "interval": 60,
      "exec-on-event": false,
      "tooltip": true
    },
    "clock#time": {
      "format": "{:%H:%M}",
      "format-alt": "{:%A %d.%m.%Y %H:%M} 󰥔",
      "tooltip": false
    },
    "group/settings": {
      "orientation": "inherit",
      "modules": [
        "custom/lock"
      ]
    },
    "custom/lock": {
      "format": "󰌾",
      "tooltip": false,
      "on-click": "playerctl --all-players pause; hyprlock"
    },
    "include": [
      "~/.config/desktop/waybar-host.jsonc"
    ]
  }
]
