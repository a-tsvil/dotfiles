@import "controls.rasi"

* {
    font: "JetBrainsMono Nerd Font 16px";
}

window {
    location: center;
    anchor: center;
    x-offset: 0px;
    y-offset: 0px;
    width: 420px;
}

inputbar {
    children: [ textbox-prompt-colon, prompt ];
}

textbox-prompt-colon {
    str: "";
}

prompt {
    font: "JetBrains Mono Bold 16px";
}

listview {
    columns: 1;
    lines: 5;
}

element {
    padding: 12px;
}
